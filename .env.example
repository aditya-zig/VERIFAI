PORT=8787
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback
VERIFIAI_STATE_SECRET=
VERIFIAI_WEB_URL=http://localhost:4173
VERIFIAI_SECURE_COOKIES=false
VERIFIAI_DATA_DIR=./data

# AWS-only agent runtime; fill model access and runtime ARN before a live run.
VERIFIAI_MODEL_PROVIDER=bedrock
AWS_REGION=ap-south-1
VERIFIAI_BEDROCK_MODEL_ID=
AWS_PROFILE=
VERIFIAI_EXECUTION_MODE=agentcore
VERIFIAI_AGENTCORE_RUNTIME_ARN=
# Bedrock model/inference-profile ARNs allowed by the runtime IAM policy.
VERIFIAI_BEDROCK_MODEL_ARNS=
# For local development only, explicit temporary AWS env credentials may be used.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# No automatic live AWS calls in normal CI.
VERIFIAI_RUN_AWS_E2E=0
# Optional tools are disabled until separately configured and verified.
VERIFIAI_EXTERNAL_ENGINE_URL=
VERIFIAI_BROWSER_USE_URL=
VERIFIAI_CUA_URL=
VERIFIAI_COMPUTER_USE_URL=
VERIFIAI_MUTATION_SERVICE_URL=
