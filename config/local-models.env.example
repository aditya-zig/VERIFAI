# Copy this file to .env.local in the checkout and chmod 600 .env.local.
# Fill values locally. Never commit .env.local or put keys in local-models.json.
# Only scripts/serve-local-api.mjs loads .env.local; the web proxy does not.
# Existing launching environment variables take precedence over this file.
XKIRO_API_KEY=
TOKEN_HARBOR_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
SEEK_AI_API_KEY=
OLLAMA_API_KEY=

# Optional custom routing file (relative to launching cwd, or absolute):
# VERIFIAI_MODEL_CONFIG=/absolute/path/to/local-models.json
# Legacy single-provider overrides are supported when MODEL_CONFIG is unset:
# VERIFIAI_MODEL_PROVIDER=xkiro
# VERIFIAI_MODEL_ID=your-selected-model
