# Copy to ignored .env.local and chmod 600 .env.local. Backend only.
VERIFIAI_MODEL_PROVIDER=bedrock
AWS_REGION=ap-south-1
VERIFIAI_BEDROCK_MODEL_ID=
# Local development: use your AWS CLI/SSO profile, or short-lived env credentials.
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional bounded Bedrock settings file:
# VERIFIAI_MODEL_CONFIG=/absolute/path/to/local-models.json
