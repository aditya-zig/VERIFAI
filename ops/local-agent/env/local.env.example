# VERIFAI local environment — PLACEHOLDERS ONLY.
# Never put real secrets in this file. Copy to a protected .env (gitignored)
# or export in your shell. See ../ENVIRONMENT.md for categorization.

# M1: no variables required.

# M2: exactly one API-backed provider (default provider is xkiro).
VERIFIAI_MODEL_PROVIDER=xkiro
VERIFIAI_MODEL_ID=
XKIRO_API_KEY=
# Alternate providers (use only if VERIFIAI_MODEL_PROVIDER selects them):
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OLLAMA_API_KEY=

# Optional local:
WEB_PORT=4173
WEB_HOST=127.0.0.1
PORT=8787
VERIFIAI_WEB_URL=http://localhost:4173
VERIFIAI_DATA_DIR=./data

# Legacy OAuth (required only by start:api, not by the M2 local flow):
VERIFIAI_STATE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
