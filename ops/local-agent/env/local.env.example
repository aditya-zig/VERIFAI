# Placeholders only. Never commit real secrets.
PORT=8787
VERIFIAI_WEB_URL=http://localhost:4173
VERIFIAI_SECURE_COOKIES=false
VERIFIAI_DATA_DIR=./data

# M2: choose one existing API-backed provider.
VERIFIAI_MODEL_PROVIDER=openrouter
VERIFIAI_MODEL_ID=<provider-model-id>
VERIFIAI_MODEL_BASE_URL=
OPENROUTER_API_KEY=<set-privately-if-used>
NVIDIA_API_KEY=<set-privately-if-used>

# Only if a legacy/auth flow is intentionally being tested.
VERIFIAI_STATE_SECRET=<set-privately-if-required>
GITHUB_CLIENT_ID=<optional>
GITHUB_CLIENT_SECRET=<optional>
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback
GOOGLE_CLIENT_ID=<optional>
GOOGLE_CLIENT_SECRET=<optional>
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback
