# VERIFAI local environment — PLACEHOLDERS ONLY.
# Never put real secrets in this file. Copy to a protected .env (gitignored)
# or export in your shell. See ../ENVIRONMENT.md for categorization.
# The startup scripts do not automatically source this file.

# M1: no variables required.

# AWS Bedrock analysis via Strands (the only supported model provider).
VERIFIAI_MODEL_PROVIDER=bedrock
VERIFIAI_BEDROCK_MODEL_ID=
# Fallback model ID if the Bedrock-specific variable is unset:
VERIFIAI_MODEL_ID=
AWS_REGION=
# Fallback region if AWS_REGION is unset:
AWS_DEFAULT_REGION=

# Local AWS profile/SSO, optionally with shared credentials/config files.
# AgentCore workers instead use the execution IAM role.
AWS_PROFILE=
AWS_SHARED_CREDENTIALS_FILE=
AWS_CONFIG_FILE=
# Alternative: temporary environment credentials (never commit values).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternative supported Bedrock bearer token:
AWS_BEARER_TOKEN_BEDROCK=

# Live AWS E2E is disabled by default. Only an authorized run opts in with 1.
VERIFIAI_RUN_AWS_E2E=0

# Optional local:
WEB_PORT=4173
WEB_HOST=127.0.0.1
PORT=8787
VERIFIAI_WEB_URL=http://localhost:4173
VERIFIAI_DATA_DIR=./data

# Ref #81: scoped bearer principals for protected local writes.
# JSON array of {id, kind: 'human'|'agent', repositories: ['owner/name'], token}.
# Tokens must be at least 32 chars. Unset/invalid config fails those writes
# closed (503); wrong/missing bearer token is 401; kind/scope mismatch is 403.
# Never commit real tokens; generate with e.g. `openssl rand -hex 32`.
# export VERIFIAI_LOCAL_PRINCIPALS_JSON='[{"id":"operator-human","kind":"human","repositories":["octocat/Hello-World"],"token":"<64-hex>"}]'
